{
  "expo": {
    "name": "Ink",
    "slug": "ink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ink",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090a",
    "splash": {
      "backgroundColor": "#08090a",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "3ZNRF29847",
      "bundleIdentifier": "com.ink.lifecalendar",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.ink.lifecalendar"]
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ink lets you attach one photo to the week you're locking into ink.",
        "NSPhotoLibraryAddUsageDescription": "Ink saves your life-grid wallpaper into your Photos."
      }
    },
    "android": {
      "package": "com.ink.lifecalendar"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ink lets you attach one photo to the week you're locking into ink."
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Ink saves your life-grid wallpaper to Photos.",
          "savePhotosPermission": "Ink saves your life-grid wallpaper into the Ink album.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@bacons/apple-targets"
    ]
  }
}
